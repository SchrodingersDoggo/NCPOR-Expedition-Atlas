PORT=5000
NODE_ENV=development

# PostgreSQL (used by Prisma)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ncpor_portal?schema=public"

# Auth
JWT_SECRET=change_this_to_a_random_string
JWT_EXPIRES_IN=7d

# Cloudinary (used for uploaded source videos + generated voiceover audio)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Existing portal AI features (only needed if other non-Studio routes still use Gemini)
GEMINI_API_KEY=your_key_here

# Frontend origin
FRONTEND_URL=http://localhost:5173

# Researcher Studio — video understanding
TWELVELABS_API_KEY=your_twelvelabs_key_here
TWELVELABS_MODEL=pegasus1.5

# Researcher Studio — English AI voiceover
# If the key is missing or ElevenLabs fails, Studio still renders the reel with original footage audio.
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# Researcher Studio — final 9:16 reel rendering
CREATOMATE_API_KEY=your_creatomate_key_here

# Public URL of the deployed Node backend for Creatomate webhook callbacks.
# For local testing this may be omitted because the frontend also polls render status.
PUBLIC_API_URL=http://localhost:5000

# MinIO / S3-compatible scientific dataset storage (Phase 1)
# These settings are intentionally separate from Cloudinary.
# For local MinIO, use localhost:9000 without SSL unless you configured HTTPS yourself.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=ncpor-datasets
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# Browser origin allowed to upload/download directly from the private dataset bucket.
# Production: set this to the deployed frontend origin.
MINIO_CORS_ORIGIN=http://localhost:5173

# Presigned URL lifetimes (seconds). Part URLs are intentionally long enough
# for very slow scientific-station links; download URLs stay shorter.
MINIO_PART_URL_EXPIRY_SECONDS=3600
MINIO_DOWNLOAD_URL_EXPIRY_SECONDS=900
MINIO_UPLOAD_SESSION_EXPIRES_IN=7d
